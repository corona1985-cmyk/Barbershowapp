# BarberShow - Variables de entorno (copia a .env.local y rellena)
# No subas .env ni .env.local a Git. No pongas secretos de servidor aquí.

# --- Cliente (Vite) ---
# true en desarrollo local para no escribir en producción.
VITE_USE_FIREBASE_EMULATOR=true

# Proyecto Firebase de este ambiente (dev / staging / prod)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 web). Obligatorio antes de ENFORCE_APP_CHECK=true
# VITE_RECAPTCHA_SITE_KEY=

# URL pública de la app (QR). Por defecto config/app.ts
# VITE_APP_PUBLIC_URL=https://barbershow.net

# AdMob nativo
# VITE_ADMOB_BANNER_ANDROID=
# VITE_ADMOB_BANNER_IOS=

# --- Cloud Functions (NO van en Vite; configúralas en el proyecto Functions) ---
# MASTER_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ENFORCE_APP_CHECK=false
# GLOBAL_FREE_MODE=true
# GOOGLE_PLAY_PACKAGE_NAME=com.barbershow.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# APPLE_SHARED_SECRET=
# APPLE_BUNDLE_ID=com.barbershow.app
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
